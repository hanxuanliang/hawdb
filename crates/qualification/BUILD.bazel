load("@crate_index//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "skein_qualification",
    crate_name = "skein_qualification",
    crate_root = "src/lib.rs",
    srcs = [
        "src/lib.rs",
        "src/production_blocking.rs",
        "src/production_graph.rs",
        "src/production_morsel.rs",
    ],
    edition = "2024",
    aliases = aliases(),
    deps = all_crate_deps(normal = True) + [
        "//:skein",
        "//crates/query:skein_query",
    ],
    proc_macro_deps = all_crate_deps(proc_macro = True),
)

rust_test(
    name = "skein_qualification_tests",
    crate = ":skein_qualification",
    edition = "2024",
    aliases = aliases(normal_dev = True, proc_macro_dev = True),
    deps = all_crate_deps(normal_dev = True),
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
)

rust_test(
    name = "skein_soak_cli_tests",
    crate_root = "src/main.rs",
    srcs = ["src/main.rs"],
    edition = "2024",
    aliases = aliases(
        normal = True,
        normal_dev = True,
        proc_macro = True,
        proc_macro_dev = True,
    ),
    deps = all_crate_deps(normal = True, normal_dev = True) + [":skein_qualification"],
    proc_macro_deps = all_crate_deps(proc_macro = True, proc_macro_dev = True),
)
